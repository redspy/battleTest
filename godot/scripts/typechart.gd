class_name TypeChart
## 선출 분석용 타입 상성표 (공격 타입 → 효과가 굉장한 / 별로인 / 없는 방어 타입). 표시·분석 전용.

const SUPER := {
	"노말": [], "불꽃": ["풀", "얼음", "벌레", "강철"], "물": ["불꽃", "땅", "바위"], "전기": ["물", "비행"],
	"풀": ["물", "땅", "바위"], "얼음": ["풀", "땅", "비행", "드래곤"], "격투": ["노말", "얼음", "바위", "악", "강철"],
	"독": ["풀", "페어리"], "땅": ["불꽃", "전기", "독", "바위", "강철"], "비행": ["풀", "격투", "벌레"],
	"에스퍼": ["격투", "독"], "벌레": ["풀", "에스퍼", "악"], "바위": ["불꽃", "얼음", "비행", "벌레"],
	"고스트": ["에스퍼", "고스트"], "드래곤": ["드래곤"], "악": ["에스퍼", "고스트"], "강철": ["얼음", "바위", "페어리"],
	"페어리": ["격투", "드래곤", "악"],
}
const WEAK := {
	"노말": ["바위", "강철"], "불꽃": ["불꽃", "물", "바위", "드래곤"], "물": ["물", "풀", "드래곤"], "전기": ["전기", "풀", "드래곤"],
	"풀": ["불꽃", "풀", "독", "비행", "벌레", "드래곤", "강철"], "얼음": ["불꽃", "물", "얼음", "강철"],
	"격투": ["독", "비행", "에스퍼", "벌레", "페어리"], "독": ["독", "땅", "바위", "고스트"], "땅": ["풀", "벌레"],
	"비행": ["전기", "바위", "강철"], "에스퍼": ["에스퍼", "강철"], "벌레": ["불꽃", "격투", "독", "비행", "고스트", "강철", "페어리"],
	"바위": ["격투", "땅", "강철"], "고스트": ["악"], "드래곤": ["강철"], "악": ["격투", "악", "페어리"],
	"강철": ["불꽃", "물", "전기", "강철"], "페어리": ["불꽃", "독", "강철"],
}
const NONE := {
	"노말": ["고스트"], "전기": ["땅"], "격투": ["고스트"], "독": ["강철"], "땅": ["비행"], "에스퍼": ["악"], "고스트": ["노말"], "드래곤": ["페어리"],
}

## 공격 타입 하나가 방어 타입들에 주는 배율
static func mult(att: String, def_types: Array) -> float:
	var m := 1.0
	for d in def_types:
		if d in NONE.get(att, []):
			return 0.0
		if d in SUPER.get(att, []):
			m *= 2.0
		elif d in WEAK.get(att, []):
			m *= 0.5
	return m

## 공격 쪽 타입(자속) 중 가장 잘 들어가는 배율
static func best(att_types: Array, def_types: Array) -> float:
	var b := 0.0
	for a in att_types:
		b = maxf(b, mult(str(a), def_types))
	return b

## a 가 b 를 상대로 한 상성 점수: 내가 주는 최대 배율 - 내가 받는 최대 배율
static func edge(a_types: Array, b_types: Array) -> float:
	return best(a_types, b_types) - best(b_types, a_types)

## 이 타입들을 2배 이상으로 때리는 공격 타입 목록
static func weaknesses(def_types: Array) -> Array:
	var out := []
	for a in SUPER.keys():
		if mult(a, def_types) >= 2.0:
			out.append(a)
	return out
